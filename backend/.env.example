# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRE_MINUTES=120

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example for production: https://gethired4u.in,https://www.gethired4u.in
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Resume analysis ───────────────────────────────────────────────────────────
RESUME_ANALYSIS_WORKERS=4

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Leave GROQ_API_KEY blank to use only the deterministic ATS scorer (no AI cost)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server base URL (fallback when S3 is off) ─────────────────────────────────
# Local dev: http://localhost:8000
# Production: https://api.gethired4u.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@gethired4u.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@gethired4u.com
SMTP_FROM_NAME=GetHired4U Team
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SUPPORT_EMAIL=support@gethired4u.com
WHATSAPP_LINK=https://wa.me/918328221007

BASE_URL=http://localhost:8000

# ── AWS S3 — Resume Storage ───────────────────────────────────────────────────
# Create IAM user → attach S3 policy → generate access keys → paste here
# Leave blank to fall back to local file storage (dev only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── Razorpay — Payment Gateway ────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
